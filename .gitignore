# 测试环境
.test-install/

# 本地环境变量
.env

# 项目敏感文件与集成测试 Bitwarden 凭据（勿提交）
.secrets/

# dec pull 在本仓库自身产生的本地产物：缓存、版本戳、以及渲染到各 IDE 的资产副本。
# mcp.json 含本机绝对路径，换机即失效；skills 副本头部本身标注了「勿直接编辑」。
# 只忽略产物路径，不要写成 .cursor/ —— 那会连带吞掉仓库自己的 .cursor/rules/。
.dec/cache/
.dec/.version
.mcp.json
.cursor/mcp.json
.cursor/skills/
.codebuddy/skills/
.with/

# Go 构建/模块缓存（scripts/goenv.sh 把它们收进项目内）
.cache/

# 临时文件
resources/temp/*
!resources/temp/.gitkeep

# 临时脚本目录
scripts/temp/*
!scripts/temp/.gitkeep

# Documents 临时文档（如果使用 Documents 目录）
Documents/temp/*
!Documents/temp/.gitkeep

# 本地用户配置
.config/
mise.local.toml

# 密钥私钥文件防误提交
*.private.pb

# Rust 托盘构建产物
/tray/target/

# COS 探针脚本含真实 SecretId 与预签名 URL，不入库（2026-10-23 转公开前移除）
cos-probe.sh
