.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# 开发根目录（开发时使用）
.root/

.relkit/
relkit/
staged.tar.gz
publish-req.json
dist/
logs/
*.log

# 测试环境
.test-install/

# 本地环境变量
.env

# 项目敏感文件与集成测试 Bitwarden 凭据（勿提交）
.secrets/

# dec pull 在本仓库自身产生的本地产物：缓存、版本戳、以及渲染到各 IDE 的资产副本。
# mcp.json 含本机绝对路径，换机即失效；skills 副本头部本身标注了「勿直接编辑」。
# 只忽略产物路径，不要写成 .cursor/ —— 那会连带吞掉仓库自己的 .cursor/rules/。
.dec/cache/
.dec/.version
.mcp.json
.cursor/mcp.json
.cursor/skills/
.codebuddy/skills/

# 临时文件
resources/temp/*
!resources/temp/.gitkeep

# 临时脚本目录
scripts/temp/*
!scripts/temp/.gitkeep

# Documents 临时文档（如果使用 Documents 目录）
Documents/temp/*
!Documents/temp/.gitkeep

# 本地用户配置
.config/
mise.local.toml

# relkit signing private keys (never commit)
.relkit-keys/*.private.pb
*.private.pb

