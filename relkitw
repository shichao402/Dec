fi
EXPECTED_ROOT="sha256:8bcb6c24c9ce672f315f96eff446d9cee7edd2c6f3bfa113a3d4927f00199598"
OPERATOR_HASH="db646a6927dfb1c0fbf68fa5a0643bbd3193b42ec0b80907c352db3d8abda8cc"

if [ -n "${RELKIT_BOOTSTRAP_CLI:-}" ]; then
  BOOTSTRAP="$RELKIT_BOOTSTRAP_CLI"
elif [ -x "$ROOT/.relkit/bootstrap/relkit" ]; then
  BOOTSTRAP="$ROOT/.relkit/bootstrap/relkit"
elif [ -n "${RELKIT_HOME:-}" ]; then
