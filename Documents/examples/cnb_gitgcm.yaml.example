# 示例：CNB HTTPS → Git Credential Manager
#
# Bitwarden Secure Note 名：cnb_gitgcm.yaml
# 本地机器根（仅 user_enabled、无项目覆盖时）：
#   ~/.dec/secrets/bundles/cnb/cnb_gitgcm.yaml
# Bitwarden folder：bundle/cnb
#
# 放入 user_enabled_bundles: [cnb] 后 pull 即可写入 GCM。

kind: gitgcm
host: cnb.cool
username: cnb
password: "替换为 CNB 个人访问令牌"
# protocol: https
# provider: generic
