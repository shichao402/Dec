{
  "mcpServers": {
    "dec-pkv-mcp": {
      "command": "pkv",
      "args": [
        "mcp"
      ],
      "env": {
        "PKV_WORKSPACE_ROOT": "${workspaceFolder}"
      }
    },
    "dec-tencent-cloud": {
      "command": "mise",
      "args": [
        "exec",
        "node@20",
        "--",
        "node",
        "${workspaceFolder}/.dec/cache/tencent-cloud/skills/tencent-cloud/server/dist/index.js"
      ]
    },
    "dec-vikunja-mcp": {
      "command": "mise",
      "args": [
        "exec",
        "node@20",
        "--",
        "npx",
        "-y",
        "@shichao402/vikunja-mcp"
      ],
      "env": {
        "VIKUNJA_API_TOKEN": "${VIKUNJA_API_TOKEN}",
        "VIKUNJA_URL": "${VIKUNJA_URL}"
      }
    }
  }
}