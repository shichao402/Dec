{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "dec-console",
  "version": "1.13.48",
  "identifier": "com.shichao402.dec.console",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:59124",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dec Console",
        "visible": false,
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
