{
  "product": "dec",
  "defaultChannel": "stable",
  "channels": [
    "stable",
    "dev"
  ],
  "codeStrategy": "semver",
  "retainVersions": 20,
  "signing": {
    "keyId": "dec-2026",
    "privateKeyPath": ".secrets/bundles/dec/keys/dec-2026.private.pb",
    "publicKeys": [
      {
        "keyId": "dec-2026",
        "publicKeyBase64": "zVkesjz/3BhLrZ9qCvSJN0OdrIsePL4+v6AI9CCtio4="
      }
    ]
  },
  "backends": {
    "cos": {
      "type": "s3-compatible",
      "endpoint": "https://cos.ap-guangzhou.myqcloud.com",
      "bucket": "relkit-updates-1251882798",
      "region": "ap-guangzhou",
      "prefix": "rup/",
      "baseUrl": "https://raw.firoyang.com/rup/",
      "accessKeyEnv": "COS_SECRET_ID",
      "secretKeyEnv": "COS_SECRET_KEY"
    },
    "serve": {
      "type": "relkit-compatible",
      "baseUrl": "https://publish.firoyang.com/",
      "uploadUrl": "https://publish.firoyang.com/",
      "tokenEnv": "RELKIT_SERVE_TOKEN",
      "timeoutSeconds": 600
    }
  },
  "publishTo": [
    "serve"
  ],
  "sidecar": {
    "packScript": "scripts/build-console.py"
  },
  "updater": {
    "urlAllowlist": [
      "internal/config/global.go",
      "internal/update/update.go",
      "internal/update/update_test.go",
      "internal/update/embed/relkit.json",
      "scripts/install.ps1",
      "scripts/install.sh"
    ]
  },
  "recovery": {
    "message": "Automatic updates are unavailable (network or update service failure). Download an official Dec release and install it manually.",
    "links": [
      {
        "label": "GitHub Releases",
        "url": "https://github.com/shichao402/Dec/releases"
      },
      {
        "label": "CNB Releases",
        "url": "https://cnb.cool/shichao402/Dec/-/releases"
      }
    ]
  },
  "site": {
    "title": "Dec",
    "description": "\u4e2a\u4eba AI \u77e5\u8bc6\u4ed3\u5e93\u4ee3\u7406\u3002",
    "homepage": "https://cnb.cool/shichao402/Dec"
  },
  "directory": {
    "publishTo": [
      "serve"
    ],
    "entryUrls": [
      "https://update-internal.firoyang.com/directory/dec.pb"
    ],
    "services": [
      {
        "id": "update-internal-primary",
        "priority": 10,
        "indexUrl": "https://update-internal.firoyang.com/index/dec/stable.pb",
        "channel": "stable"
      },
      {
        "id": "update-internal-dev",
        "priority": 10,
        "indexUrl": "https://update-internal.firoyang.com/index/dec/dev.pb",
        "channel": "dev"
      }
    ]
  }
}